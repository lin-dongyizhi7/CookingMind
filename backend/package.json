{
  "name": "cooking-mind-backend",
  "version": "1.0.0",
  "description": "食光家家庭餐饮制作多模态应用后端",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "dev:local": "NODE_ENV=development nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "setup:dev": "cp env.development.example .env.development && echo '开发环境配置已创建，请编辑 .env.development 文件'",
    "setup:prod": "cp env.production.example .env.production && echo '生产环境配置已创建，请编辑 .env.production 文件'",
    "health": "curl http://localhost:3000/health || echo '服务未运行'"
  },
  "keywords": ["cooking", "ai", "multimodal", "food"],
  "author": "CookingMind Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "mongoose": "^8.0.0",
    "socket.io": "^4.7.4",
    "redis": "^4.6.10"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0"
  }
}
